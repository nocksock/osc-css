{
  "name": "osc-css",
  "description": "CSS properties to animate numeric values where they are needed using oscillators and envelopes.",
  "version": "0.9.0",
  "homepage": "https://osc.style/",
  "title": "osc-css",
  "repository": {
    "type": "git",
    "url": "https://github.com/nocksock/osc-css"
  },
  "keywords": [
    "css",
    "animation",
    "custom-properties",
    "css-vars",
    "oscillators",
    "math",
    "trigonometry"
  ],
  "main": "osc.css",
  "unpkg": "osc.css",
  "files": [
    "osc.css",
    "fns.css"
  ],
  "scripts": {
    "dev": "vite",
    "site:build": "vite build",
    "site:preview": "vite preview",
    "site:deploy": "pnpm run build && pnpm run site:sync",
    "site:deploy:sync": "rsync -r dist/ cool:/var/www/osc.style/",
    "release:minor": "pnpm version minor && pnpm publish",
    "release:patch": "pnpm version patch && pnpm publish",
    "release:canary": "pnpm version prerelease --preid=canary && pnpm publish --tag canary --no-git-checks"
  },
  "author": "Nils Riedemann",
  "license": "MIT",
  "devDependencies": {
    "vite": "^6.2.1"
  }
}
